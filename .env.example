# Copy this file to .env and paste in your own FREE API keys.
# Never commit .env (it is listed in .gitignore).

# Finnhub (free): https://finnhub.io/register  -> used for live ETF quotes (/quote)
FINNHUB_API_KEY=

# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html  -> 3-month T-bill rate (DTB3)
FRED_API_KEY=

# Tiingo (free, optional fallback for prices): https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
